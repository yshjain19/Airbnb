<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- ✅ Dynamic Title & Description per page -->
    <title><%= locals.pageTitle || 'PrestigeStay | Vacation Rental & Holiday Homes Booking' %></title>
    <meta name="description" content="<%= locals.pageDescription || 'PrestigeStay lets you discover and book unique vacation rentals — beach houses, mountain retreats, castles, farms and more. Best price guaranteed.' %>">

    <!-- Favicon -->
    <link rel="icon"
        href="https://imgs.search.brave.com/c8W9rAvc0tnW3ccMSsx4UJMQrTCZ6Zb5XdkrzAc8a54/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9jZG4u/YnJhbmRmZXRjaC5p/by9pZGt1dlhuak9I/L3cvNDAwL2gvNDAw/L3RoZW1lL2Rhcmsv/aWNvbi5qcGVnP2M9/MWJ4aWQ2NE11cDdh/Y3pld1NBWU1YJnQ9/MTcxNzE0NjQ1OTYx/MA"
        type="image/jpeg">

    <!-- ✅ Performance: Preconnect to external origins -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://res.cloudinary.com">

    <!-- Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/CSS/style.css">
    <link rel="stylesheet" href="/CSS/rating.css">

    <!-- ✅ Primary SEO -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="author" content="PrestigeStay">
    <meta name="keywords" content="vacation rental, holiday home booking, short stay rental India, homestay booking, book unique stays, beach house rental, mountain retreat booking, PrestigeStay">
    <meta name="theme-color" content="#ef4444">
    <link rel="canonical" href="https://prestigestay.onrender.com<%= locals.canonicalPath || '/' %>">

    <!-- ✅ Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="<%= locals.ogType || 'website' %>">
    <meta property="og:url" content="https://prestigestay.onrender.com<%= locals.canonicalPath || '/' %>">
    <meta property="og:title" content="<%= locals.pageTitle || 'PrestigeStay | Vacation Rental & Holiday Homes Booking' %>">
    <meta property="og:description" content="<%= locals.pageDescription || 'Discover and book unique vacation stays worldwide. Browse beach houses, mountain retreats, castles, farms, and more on PrestigeStay.' %>">
    <meta property="og:image" content="<%= locals.ogImage || 'https://prestigestay.onrender.com/images/og-image.jpg' %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="PrestigeStay">
    <meta property="og:locale" content="en_IN">

    <!-- ✅ Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@PrestigeStay">
    <meta name="twitter:title" content="<%= locals.pageTitle || 'PrestigeStay | Vacation Rental & Holiday Homes Booking' %>">
    <meta name="twitter:description" content="<%= locals.pageDescription || 'Discover and book unique vacation stays worldwide.' %>">
    <meta name="twitter:image" content="<%= locals.ogImage || 'https://prestigestay.onrender.com/images/og-image.jpg' %>">

    <!-- ✅ Google Verification -->
    <meta name="google-site-verification" content="n0TPgwEvsHs1AsQA1nlncfBbwXJfuoEjprBGAdHyxMU" />

    <!-- ✅ JSON-LD: WebSite + Sitelinks SearchBox -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "PrestigeStay",
      "url": "https://prestigestay.onrender.com/",
      "description": "Discover and book unique vacation rentals worldwide — beach houses, mountain retreats, castles, farms and more.",
      "publisher": {
        "@type": "Organization",
        "name": "PrestigeStay",
        "url": "https://prestigestay.onrender.com/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://prestigestay.onrender.com/images/og-image.jpg"
        }
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://prestigestay.onrender.com/listings?search={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    <!-- ✅ Page-specific JSON-LD injected from controller -->
    <%- locals.jsonLd || '' %>
</head>

<body>
    <%- include("../include/nav.ejs") %>
    <main class="<%= locals.fullWidth ? 'full-width-layout' : 'container py-4' %>">
        <%- include("../include/flash.ejs") %>
        <%- body %>
    </main>
    <%- include("../include/footer.ejs") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <script src="/JS/script.js"></script>
</body>

</html>